rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return me().role;
    }

    function myCenterIds() {
      return me().centerIds;
    }

    function myStudentIds() {
      return me().get('studentIds', []);
    }

    function isOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    function isOwnerOrManager() {
      return isSignedIn() && myRole() in ['owner', 'manager'];
    }

    function isStaff() {
      return isSignedIn() && myRole() in ['owner', 'manager', 'teacher', 'ta'];
    }

    function isStaffOfCenter(centerId) {
      return isStaff() && centerId in myCenterIds();
    }

    function isParentOfStudent(studentId) {
      return isSignedIn() && myRole() == 'parent' && studentId in myStudentIds();
    }

    // --- Bootstrap marker: exactly one document, created atomically alongside the very
    // first user's self-signup as 'owner' (see authStore.ts). Its own create rule only
    // allows that one-time creation; nothing may ever update or delete it, so no client
    // can mint a second owner later.
    match /meta/bootstrap {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !exists(/databases/$(database)/documents/meta/bootstrap) &&
        request.resource.data.ownerClaimed == true;
      allow update, delete: if false;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwnerOrManager());
      // Self-signup always writes role 'parent' for itself — except the very first account
      // ever, which is allowed 'owner' only when it also creates meta/bootstrap in the same
      // transaction (getAfter reads the post-write state, so this is impossible to fake:
      // claiming 'owner' without that companion write fails, and meta/bootstrap's own create
      // rule above means only one caller can ever win that race).
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (
          request.resource.data.role == 'parent' ||
          (
            request.resource.data.role == 'owner' &&
            !exists(/databases/$(database)/documents/meta/bootstrap) &&
            getAfter(/databases/$(database)/documents/meta/bootstrap).data.ownerClaimed == true
          )
        );
      // Only owner/manager can change role/centerIds/studentIds (access control fields).
      allow update: if isOwnerOrManager() ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.centerIds == resource.data.centerIds);
      allow delete: if isOwner();
    }

    // --- Centers ---
    match /centers/{centerId} {
      allow read: if isStaffOfCenter(centerId);
      allow write: if isOwnerOrManager();
    }

    // --- Classes ---
    match /classes/{classId} {
      // Any signed-in user can read class metadata (name/schedule/teacher) — no financial
      // data lives here. Parents need this to show "which class is my child in".
      allow read: if isSignedIn();
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId);
      allow update, delete: if isOwnerOrManager() && isStaffOfCenter(resource.data.centerId);
    }

    // --- Class sessions ---
    match /classSessions/{sessionId} {
      // `resource == null` handles the get-or-create read in Attendance: checking whether
      // today's session doc exists yet is a `get` on a possibly-nonexistent document, and
      // without this guard `resource.data.centerId` throws (resource is null) instead of
      // just correctly reporting "not found".
      allow read: if resource == null || isStaffOfCenter(resource.data.centerId);
      // Any staff of the center (not just owner/manager) can create today's session doc —
      // teachers/TAs open Attendance and get-or-create it on the fly.
      allow create: if isStaffOfCenter(request.resource.data.centerId);
      allow update: if isStaffOfCenter(resource.data.centerId);
      allow delete: if isOwnerOrManager();
    }

    // --- Students ---
    match /students/{studentId} {
      allow read: if isStaffOfCenter(resource.data.centerId) || isParentOfStudent(studentId);
      allow create, update: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId);
      allow delete: if isOwner();
    }

    // --- Enrollments (session packages) ---
    match /enrollments/{enrollmentId} {
      allow read: if isStaffOfCenter(resource.data.centerId) || isParentOfStudent(resource.data.studentId);
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId);
      // Selling/editing a package (any field) stays owner/manager only. Any staff of the
      // center (teacher/TA included) may additionally update *only* the three credit-tracking
      // fields — this is what lets attendance run the FIFO deduction straight from the client
      // (see app/src/lib/creditDeduction.ts) without a Cloud Function in between.
      allow update: if (isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId)) ||
        (isStaffOfCenter(resource.data.centerId) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['usedSessions', 'remainingSessions', 'active']));
      allow delete: if isOwner();
    }

    // --- Credit ledger (append-only, system-managed) ---
    match /creditLedger/{entryId} {
      allow read: if isStaff() || isParentOfStudent(resource.data.studentId);
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // --- Attendance ---
    match /attendance/{attendanceId} {
      allow read: if isStaffOfCenter(resource.data.centerId) || isParentOfStudent(resource.data.studentId);
      allow create: if isStaffOfCenter(request.resource.data.centerId);
      allow update: if isStaffOfCenter(resource.data.centerId);
      allow delete: if isOwnerOrManager();
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if isStaffOfCenter(resource.data.centerId) || isParentOfStudent(resource.data.studentId);
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId);
      allow update, delete: if isOwner();
    }

    // --- Teacher/TA session confirmation ---
    match /teacherAttendance/{id} {
      allow read: if isStaffOfCenter(resource.data.centerId);
      allow create, update: if isStaffOfCenter(resource.data.centerId);
      allow delete: if isOwnerOrManager();
    }

    // --- Payroll (financial, restricted) ---
    match /payroll/{id} {
      allow read: if isOwnerOrManager() ||
        (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow write: if isOwnerOrManager();
    }
  }
}
