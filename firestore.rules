rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function me() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return me().role;
    }

    function myOrgId() {
      return me().orgId;
    }

    function myCenterIds() {
      return me().centerIds;
    }

    function myStudentIds() {
      return me().get('studentIds', []);
    }

    function isOwner() {
      return isSignedIn() && myRole() == 'owner';
    }

    function isOwnerOrManager() {
      return isSignedIn() && myRole() in ['owner', 'manager'];
    }

    function isStaff() {
      return isSignedIn() && myRole() in ['owner', 'manager', 'teacher', 'ta'];
    }

    function isStaffOfCenter(centerId) {
      return isStaff() && centerId in myCenterIds();
    }

    function isParentOfStudent(studentId) {
      return isSignedIn() && myRole() == 'parent' && studentId in myStudentIds();
    }

    // The one account (by email, not Firestore role — it doesn't belong to any single org)
    // that runs Trang quản trị: sees every organization and flips billing status. Mirrored in
    // app/src/lib/superAdmin.ts — keep both in sync if this ever changes.
    function isSuperAdmin() {
      return isSignedIn() && request.auth.token.email == 'haunn.vietanhschool@gmail.com';
    }

    // A suspended organization must be locked out of its actual data, not just have the
    // rendered app hide it (Layout.tsx only hides the UI — that's not enforcement on its
    // own). Every business-data collection below requires this. `organizations/{orgId}` and
    // `users/{uid}` are deliberately NOT gated by it: the app has to be able to read those
    // two to even determine *that* the org is suspended and show the lockout screen.
    function orgActive() {
      return isSuperAdmin() ||
        get(/databases/$(database)/documents/organizations/$(myOrgId())).data.status != 'suspended';
    }

    // --- Organizations (tenants) ---
    // One document per paying customer. Every other collection carries an orgId and every
    // rule below checks it against myOrgId() — that's what actually keeps two organizations'
    // data apart; centerIds/roles only decide what a user can do *within* their own org.
    match /organizations/{orgId} {
      allow read: if isSuperAdmin() || (isSignedIn() && myOrgId() == orgId);
      // Created once, atomically, by the account that becomes its owner (see the
      // `users/{userId}` create rule below, which requires this same-transaction pairing).
      // Always starts 'trial' — nobody can self-grant 'active' at signup.
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.status == 'trial';
      // The org's own owner/manager can rename it etc., but never touch status or ownerId —
      // only the Super Admin (Trang quản trị) grants/revokes billing status.
      allow update: if isSuperAdmin() ||
        (isOwnerOrManager() && myOrgId() == orgId &&
          request.resource.data.status == resource.data.status &&
          request.resource.data.ownerId == resource.data.ownerId);
      allow delete: if false;
    }

    // --- Users ---
    match /users/{userId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == userId || isSuperAdmin() ||
          (isOwnerOrManager() && resource.data.orgId == myOrgId()));
      // Signing up either creates a brand-new organization (this account becomes its
      // 'owner' — the very first account for that org) or joins an existing one by its
      // orgId (always as 'parent'; staff roles are granted afterwards from the Nhân sự
      // page by that org's own owner/manager). `getAfter` reads the post-write state, so
      // claiming 'owner' is only valid when this same request also creates that
      // organizations/{orgId} doc — and that doc's own create rule (above) means each
      // orgId can only ever be claimed once, so nobody can mint themselves a second owner
      // for an org that already has one.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        (
          (
            request.resource.data.role == 'owner' &&
            !exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)) &&
            getAfter(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid
          ) ||
          (
            request.resource.data.role == 'parent' &&
            exists(/databases/$(database)/documents/organizations/$(request.resource.data.orgId))
          )
        );
      // Only owner/manager of the SAME org can change role/centerIds/studentIds.
      allow update: if (isOwnerOrManager() && resource.data.orgId == myOrgId() && request.resource.data.orgId == resource.data.orgId) ||
        (isSignedIn() && request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.centerIds == resource.data.centerIds);
      allow delete: if isOwner() && resource.data.orgId == myOrgId();
    }

    // --- Centers ---
    match /centers/{centerId} {
      allow read: if isStaffOfCenter(centerId) && resource.data.orgId == myOrgId() && orgActive();
      allow create: if isOwnerOrManager() && request.resource.data.orgId == myOrgId() && orgActive();
      // orgId is pinned to its existing value — without this, an owner/manager editing their
      // own center could reassign the document to a different org's namespace by changing
      // the field, since the rule otherwise only checks which org the doc *currently* belongs to.
      allow update: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId;
      allow delete: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Classes ---
    match /classes/{classId} {
      // Any signed-in user of the same org can read class metadata (name/schedule/teacher)
      // — no financial data lives here. Parents need this to show "which class is my child
      // in".
      allow read: if isSignedIn() && resource.data.orgId == myOrgId() && orgActive();
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      // orgId/centerId pinned to their existing values on update — see the `centers` rule
      // above for why (prevents a document from being reassigned to another org/center).
      allow update: if isOwnerOrManager() && isStaffOfCenter(resource.data.centerId) &&
        resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.centerId == resource.data.centerId;
      allow delete: if isOwnerOrManager() && isStaffOfCenter(resource.data.centerId) &&
        resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Class sessions ---
    match /classSessions/{sessionId} {
      // `resource == null` handles the get-or-create read in Attendance: checking whether
      // today's session doc exists yet is a `get` on a possibly-nonexistent document, and
      // without this guard `resource.data.centerId` throws (resource is null) instead of
      // just correctly reporting "not found".
      allow read: if resource == null ||
        (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive());
      // Any staff of the center (not just owner/manager) can create today's session doc —
      // teachers/TAs open Attendance and get-or-create it on the fly.
      allow create: if isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      // orgId/centerId pinned on update — see the `centers` rule above.
      allow update: if isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.centerId == resource.data.centerId;
      allow delete: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Students ---
    match /students/{studentId} {
      allow read: if (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive()) ||
        isParentOfStudent(studentId);
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      // Combining create+update in one rule that only checks request.resource.data (as this
      // used to) never looks at the EXISTING document on an update — meaning it never
      // verified the student being edited actually belonged to the caller's own org, only
      // that the *new* data would. Split out so update also requires the existing doc to
      // already belong to the caller's org, and pins orgId/centerId to stay the same.
      allow update: if isOwnerOrManager() && isStaffOfCenter(resource.data.centerId) &&
        resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.centerId == resource.data.centerId;
      allow delete: if isOwner() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Enrollments (session packages) ---
    match /enrollments/{enrollmentId} {
      allow read: if (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive()) ||
        isParentOfStudent(resource.data.studentId);
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      // Selling/editing a package (any field, any value) stays owner/manager only. Any staff
      // of the center (teacher/TA included) may additionally update the three
      // credit-tracking fields — this is what lets attendance run the FIFO deduction
      // straight from the client (see app/src/lib/creditDeduction.ts) without a Cloud
      // Function in between — but ONLY as exactly "consume one session": limiting it to
      // these three field names isn't enough on its own (a malicious client could still set
      // remainingSessions to any value it likes), so the rule also pins the exact arithmetic.
      // orgId is also pinned to its existing value in both branches — otherwise an
      // owner/manager could relabel a document's orgId while still passing every other check.
      allow update: if resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        (
          (isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId)) ||
          (isStaffOfCenter(resource.data.centerId) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['usedSessions', 'remainingSessions', 'active']) &&
            request.resource.data.usedSessions == resource.data.usedSessions + 1 &&
            request.resource.data.remainingSessions == resource.data.totalSessions - request.resource.data.usedSessions &&
            request.resource.data.active == (request.resource.data.remainingSessions > 0))
        );
      allow delete: if isOwner() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Credit ledger (append-only, system-managed) ---
    match /creditLedger/{entryId} {
      // isStaffOfCenter (not just isStaff) — a staff member assigned to one center must not
      // be able to read another center's session-consumption history just because it's the
      // same organization. Requires `centerId` on every ledger entry (see
      // app/src/lib/creditDeduction.ts and app/src/types/index.ts).
      allow read: if (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive()) ||
        isParentOfStudent(resource.data.studentId);
      allow create: if isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      allow update, delete: if false;
    }

    // --- Attendance ---
    match /attendance/{attendanceId} {
      allow read: if (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive()) ||
        isParentOfStudent(resource.data.studentId);
      allow create: if isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      // orgId/centerId pinned to their existing values — see the `centers` rule above for why.
      // Every other field (status, creditApplied, enrollmentId, deductionNote, ...) stays
      // free to change: both AttendancePage's own re-record flow and creditDeduction.ts's
      // transaction write to this doc.
      allow update: if isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.centerId == resource.data.centerId;
      allow delete: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Payments ---
    match /payments/{paymentId} {
      allow read: if (isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive()) ||
        isParentOfStudent(resource.data.studentId);
      allow create: if isOwnerOrManager() && isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      allow update, delete: if isOwner() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Teacher/TA session confirmation ---
    match /teacherAttendance/{id} {
      allow read: if isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive();
      // create/update used to be combined in one rule that read `resource.data.centerId` —
      // `resource` is null on create (no document exists yet), so every create request threw
      // and was denied. Split so create checks request.resource.data instead, and update
      // additionally pins orgId/centerId to their existing values (see `centers` rule above).
      allow create: if isStaffOfCenter(request.resource.data.centerId) &&
        request.resource.data.orgId == myOrgId() && orgActive();
      allow update: if isStaffOfCenter(resource.data.centerId) && resource.data.orgId == myOrgId() && orgActive() &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.centerId == resource.data.centerId;
      allow delete: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive();
    }

    // --- Payroll (financial, restricted) ---
    match /payroll/{id} {
      allow read: if (isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive()) ||
        (isSignedIn() && resource.data.staffId == request.auth.uid);
      allow create: if isOwnerOrManager() && request.resource.data.orgId == myOrgId() && orgActive();
      allow update, delete: if isOwnerOrManager() && resource.data.orgId == myOrgId() && orgActive();
    }
  }
}
